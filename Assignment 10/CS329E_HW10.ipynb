    "# CLEAN THIS UP LATER!!! ALSO, ADD BETTER COMMENTS!\n",
    "def dbscan( df_data, eps, min_pts ):\n",
    "    NOISE_LABEL = 0\n",
    "    cluster = 0\n",
    "    df = df_data.copy() # prevent overriding\n",
    "    df['Cluster'] = None # create new column with cluster label,label=None means unvisited point\n",
    "\n",
    "    # for each point P in df_data\n",
    "    for p_idx in range(len(df)):\n",
    "\n",
    "        if df.at[p_idx, 'Cluster'] is not None: # piont already labeled, continue\n",
    "            continue\n",
    "\n",
    "        # generate range query (list) for neighbors\n",
    "        neighbors = range_query(df, p_idx, eps)\n",
    "        if len(neighbors) < min_pts:\n",
    "            df.at[p_idx, 'Cluster'] = NOISE_LABEL # mark for noise, continue\n",
    "            continue\n",
    "\n",
    "        # else: assign to next cluster, go on with rest of loop\n",
    "        cluster += 1\n",
    "        df.at[p_idx, 'Cluster'] = cluster # assign point to cluster\n",
    "\n",
    "        # seed_set: (lst) indices we should explore to see if belond to current cluter\n",
    "        seed_set = []\n",
    "        for i in neighbors.index:\n",
    "            if i != p_idx:\n",
    "                seed_set.append(i)\n",
    "        \n",
    "        # loop over potential points to add to cluster\n",
    "        while seed_set:\n",
    "            poss_point = seed_set.pop(0)\n",
    "\n",
    "            if df.at[poss_point, 'Cluster'] == NOISE_LABEL:\n",
    "                df.at[poss_point, 'Cluster'] = cluster # change noise point to border point\n",
    "            \n",
    "            if df.at[poss_point, 'Cluster'] is not None: # point already processed\n",
    "                continue\n",
    "        \n",
    "            df.at[poss_point, 'Cluster'] = cluster # add to current cluster\n",
    "\n",
    "            # explore neighbors of neighbors to fully expand cluster\n",
    "            poss_point_neighbors = range_query(df, poss_point, eps)\n",
    "            if len(poss_point_neighbors) >= min_pts:\n",
    "                for neighbor_i in poss_point_neighbors.index:\n",
    "                    if neighbor_i not in seed_set:\n",
    "                        seed_set.append(neighbor_i)\n",
    "    \n",
    "    return df['Cluster']"
   ]
